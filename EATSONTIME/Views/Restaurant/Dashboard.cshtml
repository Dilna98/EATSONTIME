@model List<EATSONTIME.Models.FoodItems>
@{
    ViewData["Title"] = "Restaurant Dashboard";
    Layout = "_Layout";
    var restaurantName = Context.Session.GetString("RestaurantName") ?? "Restaurant";
}

<div class="dashboard-container">
    <header class="dashboard-header animate__animated animate__fadeInDown">
        <div class="header-left">
            <h1 class="premium-text">Welcome, @restaurantName</h1>
            <p class="subtitle">Here are your signature cuisines and food items.</p>
        </div>
        <div class="header-right d-flex gap-3">
            <button type="button" class="btn-premium px-4" data-bs-toggle="modal" data-bs-target="#addItemModal">
                <i class="fas fa-plus"></i> Add New Item
            </button>
            <a asp-action="Logout" class="btn-logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show animate__animated animate__fadeIn" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX" role="alert">
            <strong>Error!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="stats-grid mb-5">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-utensils"></i></div>
            <div class="stat-info">
                <h3>@Model.Count</h3>
                <p>Total Items</p>
            </div>
        </div>
    </div>

    <div class="table-container animate__animated animate__fadeInUp">
        <div class="table-card">
            <div class="table-card-header">
                <h2>Cuisine & Food Directory</h2>
            </div>
            <div class="table-responsive">
                <table class="table premium-table">
                    <thead>
                        <tr>
                            <th>FoodId</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>CategoryId</th>
                            <th>RestaurentId</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="id-col">#@item.FoodId</td>
                                <td class="name-col">@item.Name</td>
                                <td class="desc-col">@item.Description</td>
                                <td class="price-col">₹@item.Price.ToString("N2")</td>
                                <td class="cat-col"><span class="badge badge-premium">@item.CategoryId</span></td>
                                <td class="res-col"><span class="badge badge-outline">@item.RestaurentId</span></td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="fas fa-clipboard-list"></i>
                                        <p>No food items found. Start by adding some cuisines!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title premium-text" id="addItemModalLabel">Add New Food Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddFoodItem" method="post" id="addItemForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="form-label font-weight-bold">Select Items (Cuisine Types)</label>
                        <div class="ets-cuisine-grid">
                            @{
                                var cuisineOptions = new[]
                                {
                                    "🍛 Biryani", "🍕 Pizza",    "🍔 Burgers",
                                    "🍜 Chinese", "🥗 Salads",   "🍩 Desserts",
                                    "🥘 Curry",   "🥪 Sandwiches","🍣 Sushi",
                                    "🥞 Breakfast","🐟 Seafood",  "🌮 Mexican"
                                };
                            }
                            @foreach (var cuisine in cuisineOptions)
                            {
                                <label class="ets-cuisine-chip" onclick="toggleChip(this)">
                                    <input type="checkbox" name="itemNames" value="@cuisine">
                                    @cuisine
                                </label>
                            }
                        </div>
                    </div>
                   
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="form-label font-weight-bold">Set Price for Selected Items (₹)</label>
                                <div class="ets-input-icon-wrap">
                                    <i class="fas fa-tag" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #b2bec3;"></i>
                                    <input type="number" step="1" name="Price" class="form-control premium-input" style="padding-left: 2.5rem;" placeholder="0" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Category</label>
                            <select name="CategoryId" class="form-select premium-input" required>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in (List<EATSONTIME.Models.Categories>)ViewBag.Categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-premium px-5 py-2">Save & Add All</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        --dark-bg: #1a1a1a;
        --card-bg: #ffffff;
        --text-muted: #636e72;
    }

    .dashboard-container {
        padding: 2rem;
        max-width: 1300px;
        margin: 0 auto;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 3rem;
    }

    .premium-text {
        font-size: 2.2rem;
        font-weight: 800;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    .subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    .btn-logout {
        padding: 0.8rem 1.5rem;
        background: #f1f2f6;
        color: #2d3436;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-logout:hover {
        background: #dfe6e9;
        transform: translateY(-2px);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .stat-card {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        background: #fff0f0;
        color: #ff4b2b;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-info h3 {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0;
    }

    .stat-info p {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.9rem;
    }

    .table-card {
        background: var(--card-bg);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        border: 1px solid #f1f2f6;
    }

    .table-card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #f1f2f6;
    }

    .table-card-header h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
    }

    .premium-table {
        width: 100%;
        margin-bottom: 0;
    }

    .premium-table thead th {
        background: #f8f9fa;
        color: #b2bec3;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 1.2rem 1.5rem;
        border: none;
    }

    .premium-table tbody td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        border-top: 1px solid #f1f2f6;
        color: #2d3436;
        font-weight: 500;
    }

    .id-col {
        color: #b2bec3;
        font-family: monospace;
    }

    .name-col {
        font-weight: 700 !important;
        color: #000 !important;
    }

    .price-col {
        color: #ff4b2b !important;
        font-weight: 800 !important;
    }

    .badge-premium {
        background: #fff0f0;
        color: #ff4b2b;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .badge-outline {
        background: transparent;
        border: 1px solid #e1e8ed;
        color: #636e72;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .empty-state {
        color: var(--text-muted);
        text-align: center;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.3;
    }

    /* Modal Styling */
    .premium-modal {
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        border: none;
        padding: 1rem;
    }

    .premium-input {
        border: 2px solid #f1f2f6;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        transition: all 0.3s ease;
    }

    .premium-input:focus {
        border-color: #ff4b2b;
        box-shadow: 0 0 0 4px rgba(255, 75, 43, 0.1);
        outline: none;
    }

    .font-weight-bold {
        font-weight: 700;
        color: #2d3436;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    /* Cuisine Grid & Chips */
    .ets-cuisine-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }
    .ets-cuisine-chip {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 15px;
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #2d3436;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
        background: white;
    }
    .ets-cuisine-chip:hover {
        border-color: #ff4b2b;
        background: #fffafa;
    }
    .ets-cuisine-chip input[type="checkbox"] {
        display: none;
    }
    .ets-cuisine-chip.checked {
        background: linear-gradient(135deg, #fffafa 0%, #fff0f0 100%);
        border-color: #ff4b2b;
        color: #ff4b2b;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 75, 43, 0.15);
    }
</style>

<script>
    function toggleChip(label) {
        const checkbox = label.querySelector('input[type="checkbox"]');
        checkbox.checked = !checkbox.checked;
        label.classList.toggle('checked', checkbox.checked);
    }
</script>
