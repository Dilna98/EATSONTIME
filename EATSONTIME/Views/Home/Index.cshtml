@using EATSONTIME.Models
@section Styles {
<style>
  body { background: #f0f0f5; }
  .ets-register-page { min-height: calc(100vh - 68px); }
  
  /* Best Foods Carousel */
  .ets-food-carousel {
      display: grid;
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      gap: 16px 32px;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 20px 0;
      scroll-behavior: smooth;
      -ms-overflow-style: none;
  }
  .ets-food-carousel::-webkit-scrollbar { display: none; }
  
  .ets-food-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      min-width: 120px;
      transition: transform 0.3s ease;
      text-align: center;
      flex-shrink: 0;
      text-decoration: none;
  }
  .ets-food-card:hover { transform: scale(1.05); }
  .ets-food-card__img-container {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 8px 20px rgba(0,0,0,0.05);
      border: 3px solid transparent;
      transition: all 0.3s ease;
  }
  .ets-food-card__img-container img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 8px;
  }
  .ets-food-card__name {
      font-weight: 700;
      color: #3d4152;
      font-size: 1.1rem;
  }
  .ets-food-card.active .ets-food-card__img-container {
      border-color: var(--orange);
      box-shadow: 0 0 20px rgba(252, 128, 25, 0.2);
  }
  .ets-food-card.active .ets-food-card__name {
      color: var(--orange);
      font-weight: 800;
  }
  
  .ets-carousel-controls { display: flex; gap: 10px; }
  .carousel-control-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      background: #e2e2e7;
      color: #3d4152;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
  }
  .carousel-control-btn:hover { background: #d4d4d9; }
  /* Dineout Style Restaurant Cards */
  .ets-restaurants-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
      padding: 20px 0;
  }
  
  .ets-dineout-card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      transition: all 0.3s ease;
      cursor: pointer;
      border: 1px solid #f0f0f5;
  }
  .ets-dineout-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }
  
  .ets-dineout-card__img-wrap {
      position: relative;
      height: 200px;
      width: 100%;
  }
  .ets-dineout-card__img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
  }
  
  .ets-dineout-card__overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 40px 16px 16px;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
  }
  
  .ets-dineout-card__name {
      color: #fff;
      font-size: 1.25rem;
      font-weight: 800;
      margin: 0;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }
  
  .ets-dineout-card__rating {
      background: #24963f;
      color: #fff;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
  }
  
  .ets-dineout-card__body {
      padding: 16px;
  }
  
  .ets-dineout-card__line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      font-size: 0.88rem;
  }
  
  .ets-dineout-card__cuisine { color: #686b78; }
  .ets-dineout-card__price { font-weight: 600; color: #3d4152; }
  .ets-dineout-card__location { color: #686b78; }
  .ets-dineout-card__distance { color: #686b78; font-weight: 500; }
  
  .ets-dineout-card__offer {
      background: #1ba672;
      color: #fff;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
  }
  
  .ets-dineout-card__bank-offer {
      background: #d1f3e0;
      color: #1ba672;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-top: 8px;
  }
  
  .ets-dineout-card__fav {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,0.9);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #686b78;
      transition: all 0.2s;
  }
  /* Premium Hero Section */
  .ets-hero-premium {
      min-height: 520px;
      padding: 80px 5%;
      background: radial-gradient(at 0% 0%, #fffbf2 0%, transparent 50%),
                  radial-gradient(at 100% 0%, #fff3e8 0%, transparent 50%),
                  radial-gradient(at 100% 100%, #ffe8d1 0%, transparent 50%),
                  radial-gradient(at 0% 100%, #fffbf2 0%, transparent 50%),
                  #fff;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
  }
  
  .ets-hero-premium__content {
      position: relative;
      z-index: 10;
      max-width: 800px;
  }
  
  .ets-hero-premium__badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #fff;
      padding: 6px 16px 6px 6px;
      border-radius: 50px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-bottom: 24px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #3d4152;
  }
  .ets-badge-new {
      background: var(--orange);
      color: #fff;
      padding: 2px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 800;
  }
  
  .ets-hero-premium__title {
      font-size: clamp(2.5rem, 6vw, 4.2rem);
      font-weight: 900;
      line-height: 1.1;
      color: #1a1a1a;
      margin-bottom: 20px;
      letter-spacing: -1.5px;
  }
  .text-gradient {
      background: linear-gradient(135deg, #FC8019, #ff5c00);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
  }
  .text-highlight {
      position: relative;
      z-index: 1;
  }
  .text-highlight::after {
      content: '';
      position: absolute;
      bottom: 10%;
      left: 0;
      width: 100%;
      height: 25%;
      background: rgba(252, 128, 25, 0.15);
      z-index: -1;
      border-radius: 4px;
  }
  
  .ets-hero-premium__subtitle {
      font-size: 1.2rem;
      color: #686b78;
      line-height: 1.6;
      margin-bottom: 40px;
      max-width: 500px;
  }
  
  /* Modern Search Bar */
  .ets-hero-premium__search-wrap {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 10px;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      border: 1px solid rgba(255,255,255,0.5);
      max-width: 720px;
  }
  .ets-hero-premium__search-form {
      display: flex;
      align-items: center;
      gap: 0;
  }
  .ets-input-with-icon {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 20px;
  }
  .ets-input-with-icon i { color: var(--orange); font-size: 1.1rem; }
  .ets-input-with-icon input {
      border: none;
      background: transparent;
      outline: none;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 500;
      color: #1a1a1a;
      width: 100%;
  }
  .ets-search-divider {
      width: 1px;
      height: 30px;
      background: #ddd;
      margin: 0 10px;
  }
  .ets-hero-premium__btn {
      background: var(--orange);
      color: #fff;
      border: none;
      padding: 14px 32px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(252, 128, 25, 0.3);
  }
  .ets-hero-premium__btn:hover {
      background: #ff5c00;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(252, 128, 25, 0.4);
  }
  
  .ets-hero-premium__stats {
      display: flex;
      align-items: center;
      gap: 40px;
      margin-top: 50px;
  }
  .ets-stat-item {
      display: flex;
      flex-direction: column;
  }
  .stat-number {
      font-size: 1.5rem;
      font-weight: 900;
      color: #1a1a1a;
  }
  .stat-label {
      font-size: 0.85rem;
      color: #686b78;
      font-weight: 600;
  }
  .ets-stat-divider {
      width: 1px;
      height: 40px;
      background: #eee;
  }
  
  /* Decoration Elements */
  .ets-hero-premium__decorations {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
  }
  .floating-item {
      position: absolute;
      font-size: 3rem;
      filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));
      animation: float-around 6s infinite ease-in-out;
  }
  .item-1 { top: 15%; right: 15%; animation-delay: 0s; font-size: 5rem; }
  .item-2 { bottom: 20%; right: 10%; animation-delay: 1s; font-size: 4rem; }
  .item-3 { top: 10%; left: 60%; animation-delay: 2s; font-size: 3.5rem; }
  .item-4 { bottom: 15%; left: 55%; animation-delay: 1.5s; font-size: 3rem; }
  .item-5 { top: 40%; right: 5%; animation-delay: 3s; font-size: 2.5rem; }
  
  @@keyframes float-around {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(15px, -20px) rotate(5deg); }
      66% { transform: translate(-10px, 15px) rotate(-5deg); }
  }
  
  .animate-float { animation: float-subtle 3s infinite ease-in-out; }
  @@keyframes float-subtle {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
  }
</style>
}
@{
    ViewData["Title"] = "Order Food Online — EATSONTIME";
    var restaurants = ViewBag.Restaurants as List<Restaurant> ?? new List<Restaurant>();
    var categories  = ViewBag.Categories  as List<string>     ?? new List<string>();
    var search      = ViewBag.Search      as string ?? "";

    // Sample data for richer card display
    var ratings      = new[] { "4.5", "4.2", "4.7", "4.1", "4.6", "4.3", "4.8", "4.0" };
    var times        = new[] { "25-30", "30-40", "20-25", "35-45", "15-20", "40-50", "22-28", "28-35" };
    var cuisines     = new[] { "Biryani • Mughlai • North Indian", "Italian • Pizza • Pasta",
                               "American • Burgers • Fries", "Chinese • Thai • Asian",
                               "Desserts • Ice Cream • Cakes", "South Indian • Kerala",
                               "Continental • Salads • Healthy", "Japanese • Sushi • Ramen" };
    var discounts    = new[] { "50% OFF up to ₹100", "Free Delivery", "30% OFF", "₹75 OFF",
                               "Buy 1 Get 1", "₹50 OFF above ₹199", "New on EATSONTIME", "20% OFF" };
    var emojis       = new[] { "🍛", "🍕", "🍔", "🍜", "🍩", "🥘", "🥗", "🍣" };
    var bgColors     = new[] { "#fff3e8", "#fce4ec", "#e8f5e9", "#e3f2fd",
                               "#f3e5f5", "#fff8e1", "#e0f7fa", "#fbe9e7" };
}

<!-- ====== PREMIUM HERO SECTION ====== -->
<section class="ets-hero-premium">
    <div class="ets-hero-premium__content ets-animate">
        <div class="ets-hero-premium__badge animate-float">
            <span class="ets-badge-new">NEW</span>
            <span>Now delivering in Calicut! 🚀</span>
        </div>
        
        <h1 class="ets-hero-premium__title">
            Your Favourite <span class="text-gradient">Food</span>,<br>
            Delivered <span class="text-highlight">Fast</span>.
        </h1>
        
        <p class="ets-hero-premium__subtitle">
            Order from the best restaurants and cafés near you.<br>
            Fresh, hot, and straight to your doorstep.
        </p>

        <div class="ets-hero-premium__search-wrap">
            <form action="/" method="get" class="ets-hero-premium__search-form">
                <div class="ets-input-with-icon">
                    <i class="fas fa-map-marker-alt"></i>
                    <input type="text" placeholder="Enter your delivery location" id="loc-input">
                </div>
                <div class="ets-search-divider"></div>
                <div class="ets-input-with-icon flex-grow-1">
                    <i class="fas fa-search"></i>
                    <input type="text" name="search" value="@search" placeholder="Search for restaurants, cuisines..." id="search-input">
                </div>
                <button type="submit" class="ets-hero-premium__btn">
                    Find Food
                </button>
            </form>
        </div>

        <div class="ets-hero-premium__stats">
            <div class="ets-stat-item">
                <span class="stat-number">500+</span>
                <span class="stat-label">Restaurants</span>
            </div>
            <div class="ets-stat-divider"></div>
            <div class="ets-stat-item">
                <span class="stat-number">25 min</span>
                <span class="stat-label">Delivery Time</span>
            </div>
            <div class="ets-stat-divider"></div>
            <div class="ets-stat-item">
                <span class="stat-number">10k+</span>
                <span class="stat-label">Orders Daily</span>
            </div>
        </div>
    </div>

    <!-- Floating Food Elements (Visual decoration) -->
    <div class="ets-hero-premium__decorations">
        <div class="floating-item item-1">🍔</div>
        <div class="floating-item item-2">🍕</div>
        <div class="floating-item item-3">🍜</div>
        <div class="floating-item item-4">🍩</div>
        <div class="floating-item item-5">🥗</div>
    </div>
</section>

<!-- ====== BEST FOOD OPTIONS (NEW) ====== -->
<section class="ets-section ets-best-foods">
    <div class="ets-section__header">
        <h2 class="ets-section__title">What's on your mind?</h2>
        <div class="ets-carousel-controls">
            <button class="carousel-control-btn prev" onclick="scrollCarousel(-1)"><i class="fas fa-arrow-left"></i></button>
            <button class="carousel-control-btn next" onclick="scrollCarousel(1)"><i class="fas fa-arrow-right"></i></button>
        </div>
    </div>
    
    <div class="ets-food-carousel" id="food-carousel">
        @{
            var carouselDishes = ViewBag.FoodItems as List<string> ?? new List<string>();
            var foodImages = new Dictionary<string, string>
            {
                { "Biryani", "/images/foods/best_biryani_card_1776446410031.png" },
                { "Pizza", "/images/foods/best_pizza_card_1776446533693.png" },
                { "Dosa", "/images/foods/best_dosa_card_1776446575917.png" },
                { "Noodles", "/images/foods/best_noodles_card_1776446607595.png" },
                { "Cake", "/images/foods/best_cake_card_1776446642302.png" },
                { "Juice", "/images/foods/best_juice_card_1776446774452.png" },
                { "Shawarma", "/images/foods/best_shawarma_card_1776446803571.png" }
            };
        }
        
        @foreach (var dish in carouselDishes)
        {
            var cleanDishName = System.Text.RegularExpressions.Regex.Replace(dish, @"[^\u0000-\u007F]+", string.Empty).Trim();
            var imgPath = foodImages.ContainsKey(cleanDishName) ? foodImages[cleanDishName] : "/images/foods/best_biryani_card_1776446410031.png";
            <a href="?dish=@cleanDishName" class="ets-food-card ets-animate animate-fade @(ViewBag.SelectedDish == cleanDishName ? "active" : "")">
                <div class="ets-food-card__img-container">
                    <img src="@Url.Content("~" + imgPath)" alt="@dish" />
                </div>
                <span class="ets-food-card__name">@dish</span>
            </a>
        }
    </div>
</section>

<!-- ====== CATEGORY PILLS ====== -->
<div class="ets-categories">
    <div class="ets-categories__strip" id="category-strip">
        <a href="/" class="ets-cat-pill @(string.IsNullOrEmpty(ViewBag.SelectedCategory) && string.IsNullOrEmpty(ViewBag.SelectedDish) ? "active" : "")">
            🍽️ All
        </a>
        @foreach (var cat in categories)
        {
            <a href="?category=@cat" class="ets-cat-pill @(ViewBag.SelectedCategory == cat ? "active" : "")">
                @cat
            </a>
        }
    </div>
</div>

<!-- ====== OFFER BANNER ====== -->
@if (string.IsNullOrEmpty(ViewBag.SelectedDish)) {
    <div class="ets-offer-banner ets-animate ets-animate-delay-2">
        <div>
            <h3>🎉 Limited Time Offer</h3>
            <p>Get 50% off on your first 3 orders. Use code <strong>WELCOME50</strong></p>
        </div>
        <a href="#restaurants-section" class="ets-offer-banner__cta">Order Now →</a>
    </div>
}

<!-- ====== RESTAURANTS SECTION ====== -->
<section class="ets-section" id="restaurants-section">
    <div class="ets-section__header">
        <h2 class="ets-section__title" id="restaurants-heading">
            @if (!string.IsNullOrEmpty(ViewBag.SelectedDish))
            {
                <span>Restaurants serving "<em>@ViewBag.SelectedDish</em>"</span>
                <a href="/" class="ms-3 btn btn-sm btn-outline-danger" style="border-radius:20px; font-size:0.75rem;">Clear Filter <i class="fas fa-times"></i></a>
            }
            else if (!string.IsNullOrEmpty(search))
            {
                <span>Results for "<em>@search</em>"</span>
                <a href="/" class="ms-3 btn btn-sm btn-outline-danger" style="border-radius:20px; font-size:0.75rem;">Clear Search <i class="fas fa-times"></i></a>
            }
            else
            {
                <span>Discover best restaurants on Dineout</span>
            }
        </h2>
        <div class="ets-carousel-controls">
            <button class="carousel-control-btn prev"><i class="fas fa-arrow-left"></i></button>
            <button class="carousel-control-btn next"><i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    @if (!restaurants.Any())
    {
        <div class="ets-empty">
            <i class="fas fa-store-slash"></i>
            <h3>No restaurants found</h3>
            <p>Try a different search term or browse all restaurants.</p>
            <a href="/" class="ets-btn ets-btn--primary">Browse All</a>
        </div>
    }
    else
    {
        var restaurantImages = ViewBag.RestaurantImages as Dictionary<string, string> ?? new Dictionary<string, string>();
        
        <div class="ets-restaurants-grid" id="restaurants-grid">
            @for (int i = 0; i < restaurants.Count; i++)
            {
                var r         = restaurants[i];
                var idx       = i % emojis.Length;
                var rating    = ratings[idx];
                var time      = times[idx];
                var cuisine   = cuisines[idx];
                var discount  = discounts[idx];
                var emoji     = emojis[idx];
                var bg        = bgColors[idx];
                
                var hasImg = restaurantImages.ContainsKey(r.Name);
                var imgPath = hasImg ? restaurantImages[r.Name] : "";

                <div class="ets-dineout-card ets-animate ets-animate-delay-@((i % 3) + 1)"
                     id="restaurant-card-@r.RestaurentId"
                     onclick="window.location='#'">
                    
                    <div class="ets-dineout-card__img-wrap">
                        @if (hasImg)
                        {
                            <img src="@Url.Content("~" + imgPath)" alt="@r.Name" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:5rem;background:#f8f9fa;">
                                @emoji
                            </div>
                        }
                        
                        <div class="ets-dineout-card__overlay">
                            <h3 class="ets-dineout-card__name">@r.Name</h3>
                            <div class="ets-dineout-card__rating">
                                <i class="fas fa-star"></i> @rating
                            </div>
                        </div>

                        <span class="ets-dineout-card__fav" title="Add to favourites" onclick="toggleFav(event, this)">
                            <i class="far fa-heart"></i>
                        </span>
                    </div>

                    <div class="ets-dineout-card__body">
                        <div class="ets-dineout-card__line">
                            <span class="ets-dineout-card__cuisine">@cuisine.Split('•')[0]</span>
                            <span class="ets-dineout-card__price">₹500 for two</span>
                        </div>
                        <div class="ets-dineout-card__line">
                            <span class="ets-dineout-card__location">@r.Address</span>
                            <span class="ets-dineout-card__distance">@(new Random().Next(1, 15)).@(new Random().Next(1, 9)) km</span>
                        </div>

                        <div class="ets-dineout-card__offer">
                            <span><i class="fas fa-percentage"></i> @discount</span>
                            <span style="opacity:0.8;">+ @(new Random().Next(1, 5)) more</span>
                        </div>

                        <div class="ets-dineout-card__bank-offer">
                            Up to 10% off with bank offers
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (Context.Session.GetInt32("UserId") != null)
{
    var recentOrders = ViewBag.RecentOrders as IEnumerable<dynamic>;
    if (recentOrders != null && recentOrders.Any())
    {
        <!-- ====== QUICK REORDER SECTION ====== -->
        <section class="ets-section" style="background:#fff; padding-bottom:40px;">
            <div class="ets-section__header">
                <h2 class="ets-section__title">📦 My Recent Orders</h2>
                <a href="/Home/Orders" class="ets-section__link" id="view-all-orders-link">
                    View all <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <div style="display:flex;gap:16px;overflow-x:auto;padding-bottom:12px;scrollbar-width:none; -ms-overflow-style: none;">
                <style>
                    .ets-recent-order-card {
                        background: #f8f9fa;
                        border-radius: 16px;
                        padding: 16px;
                        min-width: 220px;
                        flex-shrink: 0;
                        cursor: pointer;
                        transition: all 0.3s ease;
                        border: 1px solid #eee;
                    }
                    .ets-recent-order-card:hover {
                        transform: translateY(-4px);
                        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
                        border-color: var(--orange);
                    }
                    .ets-reorder-btn {
                        background: var(--orange);
                        color: #fff;
                        padding: 6px 16px;
                        border-radius: 10px;
                        font-size: 0.8rem;
                        font-weight: 700;
                        text-decoration: none;
                        transition: all 0.2s;
                    }
                    .ets-reorder-btn:hover {
                        background: #ff5c00;
                        color: #fff;
                        box-shadow: 0 4px 10px rgba(252, 128, 25, 0.3);
                    }
                </style>
                
                @foreach (var order in recentOrders)
                {
                    string dishName = order.DishName;
                    string emoji = "🍱";
                    if (dishName.ToLower().Contains("biryani")) emoji = "🍛";
                    else if (dishName.ToLower().Contains("pizza")) emoji = "🍕";
                    else if (dishName.ToLower().Contains("burger")) emoji = "🍔";
                    else if (dishName.ToLower().Contains("noodle") || dishName.ToLower().Contains("chowmein")) emoji = "🍜";
                    else if (dishName.ToLower().Contains("cake") || dishName.ToLower().Contains("pastry")) emoji = "🍰";
                    else if (dishName.ToLower().Contains("juice") || dishName.ToLower().Contains("shake")) emoji = "🥤";
                    else if (dishName.ToLower().Contains("dosa") || dishName.ToLower().Contains("idli")) emoji = "🍽️";
                    else if (dishName.ToLower().Contains("shawarma") || dishName.ToLower().Contains("roll")) emoji = "🌯";

                    <div class="ets-recent-order-card">
                        <div style="font-size:2.5rem;margin-bottom:12px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.1));">@emoji</div>
                        <div style="font-weight:700;font-size:1rem;color:var(--dark);margin-bottom:2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@order.DishName">@order.DishName</div>
                        <div style="font-size:0.8rem;color:var(--dark-light);margin-bottom:12px;">@order.RestaurantName</div>
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-weight:800;color:var(--orange);font-size:1.1rem;">₹@order.Price</span>
                            <a href="/Home/Orders" class="ets-reorder-btn">Reorder</a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}

@section Scripts {
<script>
    function scrollCarousel(dir) {
        const c = document.getElementById('food-carousel');
        const scrollAmount = 300;
        if (c) c.scrollBy({ left: dir * scrollAmount, behavior: 'smooth' });
    }

    // Favourite toggle
    function toggleFav(event, el) {
        event.stopPropagation();
        const icon = el.querySelector('i');
        if (icon.classList.contains('far')) {
            icon.classList.replace('far', 'fas');
            el.style.color = 'var(--red)';
        } else {
            icon.classList.replace('fas', 'far');
            el.style.color = '';
        }
    }

    // Category filter (visual only — extend with AJAX for real filtering)
    function filterCategory(el, cat) {
        document.querySelectorAll('.ets-cat-pill').forEach(p => p.classList.remove('active'));
        el.classList.add('active');
    }

    // Animate cards on scroll
    const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.style.opacity = '1';
                e.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.ets-restaurant-card').forEach(card => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = 'opacity 0.4s ease, transform 0.4s ease, box-shadow 0.25s ease';
        observer.observe(card);
    });
</script>
}
