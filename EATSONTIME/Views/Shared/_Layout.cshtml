<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="EATSONTIME — Order delicious food from the best restaurants near you. Fast delivery, great offers.">
    <title>@ViewData["Title"] — EATSONTIME</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- EATSONTIME Custom CSS -->
    <link rel="stylesheet" href="~/css/swiggy.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ====== NAVBAR ====== -->
    <nav class="ets-navbar">
        <a class="ets-navbar__logo" href="/" id="navbar-logo">
            <div class="ets-navbar__logo-icon">🍜</div>
            <span class="ets-navbar__logo-text">EATS<span>ON</span>TIME</span>
        </a>

        <div class="ets-navbar__location">
            <i class="fas fa-map-marker-alt"></i>
            <span>Your Location</span>
            <i class="fas fa-chevron-down" style="font-size:11px;"></i>
        </div>

        <div class="ets-navbar__search">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search for restaurants, cuisines..." id="navbar-search-input">
        </div>

        <div class="ets-navbar__actions">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <div class="ets-navbar__user">
                    <i class="fas fa-user-circle"></i> Hi, @Context.Session.GetString("UserName")
                </div>
                <a href="/Home/Orders" class="ets-btn ets-btn--outline" id="navbar-orders-btn">
                    <i class="fas fa-receipt"></i> My Orders
                </a>
                <a href="/User/Logout" class="ets-btn ets-btn--outline" id="navbar-logout-btn">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            }
            else
            {
                <a href="/User/Login" class="ets-btn ets-btn--outline" id="navbar-login-btn">
                    <i class="fas fa-user"></i> Login
                </a>
                <a href="/Restaurant/Register" class="ets-btn ets-btn--outline" id="navbar-partner-btn">
                    <i class="fas fa-store"></i> Partner with us
                </a>
            }
            
            <a href="/Home/Cart" class="ets-btn ets-btn--cart" id="navbar-cart-btn">
                <i class="fas fa-shopping-bag"></i>
                Cart
            </a>
        </div>
    </nav>

    <!-- ====== PAGE CONTENT ====== -->
    @RenderBody()

    <!-- ====== FOOTER ====== -->
    <footer class="ets-footer">
        <div class="ets-footer__grid">
            <div>
                <div class="ets-footer__brand-name">🍜 EATSONTIME</div>
                <p class="ets-footer__brand-desc">Your favourite food, delivered hot & fast. Discover the best restaurants near you and order in minutes.</p>
                <div class="ets-footer__social">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
            <div>
                <div class="ets-footer__col-title">Company</div>
                <ul class="ets-footer__links">
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="#">Team</a></li>
                    <li><a href="#">Blog</a></li>
                </ul>
            </div>
            <div>
                <div class="ets-footer__col-title">For Restaurants</div>
                <ul class="ets-footer__links">
                    <li><a href="/Restaurant/Register">Partner with us</a></li>
                    <li><a href="#">Restaurant Dashboard</a></li>
                    <li><a href="#">Advertise</a></li>
                </ul>
            </div>
            <div>
                <div class="ets-footer__col-title">Legal</div>
                <ul class="ets-footer__links">
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                    <li><a href="#">Refund Policy</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>
        </div>
        <div class="ets-footer__bottom">
            <span>&copy; @DateTime.Now.Year EATSONTIME. All rights reserved.</span>
            <span>Made with ❤️ for food lovers</span>
        </div>
    </footer>

    <!-- Toast Notification -->
    <div class="ets-toast" id="ets-toast">
        <i class="fas fa-check-circle"></i>
        <span id="ets-toast-msg">Done!</span>
    </div>

    <!-- Scripts -->
    <script>
        // Toast utility
        function showToast(msg, duration = 3000) {
            const t = document.getElementById('ets-toast');
            document.getElementById('ets-toast-msg').textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), duration);
        }

        // Show success toast from TempData
        @if (TempData["Success"] != null) {
            <text>document.addEventListener('DOMContentLoaded', () => showToast('@TempData["Success"]'));</text>
        }
    </script>

    <style>
        .ets-navbar__user {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            color: var(--dark);
            font-size: 0.95rem;
            margin-right: 15px;
        }
        .ets-navbar__user i {
            color: var(--orange);
            font-size: 1.2rem;
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
